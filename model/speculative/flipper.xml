<mujoco model="baseball_bat_ccd">
  <option timestep="0.01" gravity="0 0 -9.81">
    <flag speculative="enable"/>
  </option>
  <statistic center="0.40 -0.10 0.23" extent="1.06"/>
  <visual>
    <global realtime="0.2" elevation="-23" azimuth="118"/>
    <quality shadowsize="4096"/>
    <headlight ambient=".25 .25 .25" diffuse=".4 .4 .4" specular=".2 .2 .2"/>
    <rgba haze=".12 .16 .20 1"/>
    <scale contactwidth="0.02" contactheight="0.005" forcewidth="0.01"/>
  </visual>
  <asset>
    <texture name="ibl" type="cube" builtin="gradient" rgb1=".25 .3 .45" rgb2=".55 .5 .45" width="32" height="32"/>
    <texture type="skybox" builtin="gradient" rgb1=".12 .16 .28" rgb2=".5 .45 .4" width="32" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.2 0.25 0.3" rgb2="0.3 0.35 0.4"/>
    <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="1 -1.6 2.6" dir="-.3 .5 -.8" cutoff="35" softness="1" range="15" diffuse=".9 .85 .75" intensity="800000"/>
    <light pos="-1 1.3 2" dir=".35 -.45 -.75" cutoff="50" softness="1" range="15" diffuse=".5 .65 .8" intensity="300000" castshadow="false"/>
    <light type="image" texture="ibl" intensity="3000"/>
    <geom name="ground" type="plane" size="0 0 0.01" material="grid"/>
    <!-- Spring-loaded pitching plunger at x = 0.83 m that launches the ball on step 1 -->
    <body name="pitcher_plunger" pos="0.83 0.05 0.42">
      <joint name="plunger_slide" type="slide" axis="-1 0 0"
             springref="0.22" stiffness="2200" damping="30"
             limited="true" range="0 0.18"/>
      <geom name="plunger_head" type="box" size="0.01 0.04 0.04" mass="2.0"
            rgba="0.5 0.5 0.55 1"/>
    </body>
    <!-- Free-flying baseball (4 cm diameter) starting right in front of the plunger -->
    <body name="ball" pos="0.795 0.05 0.42">
      <freejoint/>
      <geom name="baseball" type="sphere" size="0.02" mass="0.05"
            solref="0.004 0.5" rgba="0.95 0.95 0.95 1"/>
    </body>
    <!-- Stationary pivot post for the bat -->
    <geom name="bat_post" type="cylinder" fromto="0 -0.30 0 0 -0.30 0.40"
          size="0.02" rgba="0.45 0.45 0.5 1" contype="0" conaffinity="0"/>
    <!-- Thin bat/flipper (1.2 cm thick) cocked back 65 deg, whipping through x = 0 -->
    <body name="bat_body" pos="0 -0.30 0.40" euler="0 0 65">
      <joint name="bat_swing" type="hinge" axis="0 0 -1"
             springref="80" stiffness="21" damping="0.3"/>
      <geom name="bat" type="box" pos="0 0.30 0" size="0.006 0.30 0.07"
            mass="0.4" solref="0.004 0.5" rgba="0.9 0.4 0.2 1"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="bat_motor" joint="bat_swing" gear="20" ctrlrange="-1 1"/>
  </actuator>
</mujoco>

<mujoco model="newtons_cradle_ccd">
  <option timestep="0.004" gravity="0 0 -9.81">
    <flag speculative="enable"/>
  </option>
  <statistic center="0 0 0.70" extent="1.38"/>
  <visual>
    <global realtime="0.5" elevation="-16" azimuth="110"/>
    <quality shadowsize="4096"/>
    <headlight ambient=".25 .25 .25" diffuse=".4 .4 .4" specular=".2 .2 .2"/>
    <rgba haze=".12 .16 .20 1"/>
    <map force="0.01"/>
  </visual>
  <asset>
    <texture name="ibl" type="cube" builtin="gradient" rgb1=".25 .3 .45" rgb2=".55 .5 .45" width="32" height="32"/>
    <texture type="skybox" builtin="gradient" rgb1=".12 .16 .28" rgb2=".5 .45 .4" width="32" height="512"/>
    <texture name="floor" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="512" height="512"/>
    <material name="floor" texture="floor" texrepeat="2 2" texuniform="true" reflectance=".08"/>
  </asset>
  <default>
    <joint type="hinge" axis="0 1 0" frictionloss="0.08"/>
    <default class="wire">
      <geom type="capsule" size="0.002" mass="0" contype="0" conaffinity="0"
            rgba="0.65 0.65 0.7 1"/>
    </default>
    <!-- 3mm thick steel plates (half-thickness = 0.0015m) -->
    <!-- Direct solref="0 -499" with stiff solimp="0.995 0.995 0.001" sets K = 0 and
         h*damping = 1.996 so the speculative spring term does not cancel the elastic damper -->
    <default class="plate">
      <geom type="box" pos="0 0 -1.0" size="0.0015 0.08 0.08"
            mass="0.5" friction="0" solref="0 -499" solimp="0.995 0.995 0.001"/>
    </default>
  </default>
  <worldbody>
    <light pos="1.2 -2 3" dir="-.3 .5 -.8" cutoff="35" softness="1" range="15" diffuse=".9 .85 .75" intensity="900000"/>
    <light pos="-1 1.5 2.2" dir=".35 -.45 -.75" cutoff="50" softness="1" range="15" diffuse=".5 .65 .8" intensity="300000" castshadow="false"/>
    <light type="image" texture="ibl" intensity="3000"/>
    <geom name="floor" type="plane" size="0 0 0.01" material="floor"
          contype="0" conaffinity="0"/>
    <!-- Support frame -->
    <geom type="capsule" fromto="-0.35 -0.07 1.40  0.35 -0.07 1.40" size="0.008"
          rgba="0.35 0.35 0.4 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto="-0.35  0.07 1.40  0.35  0.07 1.40" size="0.008"
          rgba="0.35 0.35 0.4 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto="-0.35 -0.07 1.40 -0.35 -0.20 0" size="0.008"
          rgba="0.35 0.35 0.4 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto=" 0.35 -0.07 1.40  0.35 -0.20 0" size="0.008"
          rgba="0.35 0.35 0.4 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto="-0.35  0.07 1.40 -0.35  0.20 0" size="0.008"
          rgba="0.35 0.35 0.4 1" contype="0" conaffinity="0"/>
    <geom type="capsule" fromto=" 0.35  0.07 1.40  0.35  0.20 0" size="0.008"
          rgba="0.35 0.35 0.4 1" contype="0" conaffinity="0"/>
    <!-- Plate 1: pulled back 58 deg (~3.0 m/s = 12mm/step at bottom, 4x plate thickness) -->
    <body name="pendulum1" pos="-0.04 0 1.40" euler="0 58 0">
      <joint name="j1"/>
      <geom class="wire" fromto="0 -0.07 0  0 -0.07 -0.92"/>
      <geom class="wire" fromto="0  0.07 0  0  0.07 -0.92"/>
      <geom name="p1" class="plate" rgba="0.9 0.25 0.25 1"/>
    </body>
    <!-- Plate 2 -->
    <body name="pendulum2" pos="-0.02 0 1.40">
      <joint name="j2"/>
      <geom class="wire" fromto="0 -0.07 0  0 -0.07 -0.92"/>
      <geom class="wire" fromto="0  0.07 0  0  0.07 -0.92"/>
      <geom name="p2" class="plate" rgba="0.75 0.8 0.85 1"/>
    </body>
    <!-- Plate 3 -->
    <body name="pendulum3" pos="0 0 1.40">
      <joint name="j3"/>
      <geom class="wire" fromto="0 -0.07 0  0 -0.07 -0.92"/>
      <geom class="wire" fromto="0  0.07 0  0  0.07 -0.92"/>
      <geom name="p3" class="plate" rgba="0.75 0.8 0.85 1"/>
    </body>
    <!-- Plate 4 -->
    <body name="pendulum4" pos="0.02 0 1.40">
      <joint name="j4"/>
      <geom class="wire" fromto="0 -0.07 0  0 -0.07 -0.92"/>
      <geom class="wire" fromto="0  0.07 0  0  0.07 -0.92"/>
      <geom name="p4" class="plate" rgba="0.75 0.8 0.85 1"/>
    </body>
    <!-- Plate 5 -->
    <body name="pendulum5" pos="0.04 0 1.40">
      <joint name="j5"/>
      <geom class="wire" fromto="0 -0.07 0  0 -0.07 -0.92"/>
      <geom class="wire" fromto="0  0.07 0  0  0.07 -0.92"/>
      <geom name="p5" class="plate" rgba="0.25 0.65 0.9 1"/>
    </body>
  </worldbody>
</mujoco>

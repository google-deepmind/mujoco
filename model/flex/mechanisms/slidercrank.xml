<mujoco model="Elastic slider-crank">
  <include file="scene.xml"/>
  <statistic center=".1 0 .55" extent="2"/>
  <worldbody>
    <camera name="overview" pos="1.3 -2.5 1.65" xyaxes="0.89442719 0.4472136 -0 -0.16634265 0.33268529 0.92825138"/>
    <geom type="box" pos=".05 0 .1" size=".85 .28 .1"/>
    <geom type="box" pos="-.5 0 .4" size=".07 .08 .2"/>
    <geom type="capsule" fromto=".1 -0.12 .7 .8 -0.12 .7" size=".014" material="silver"/>
    <geom type="box" pos="0.1 -0.12 .45" size=".035 .035 .25"/>
    <geom type="box" pos="0.8 -0.12 .45" size=".035 .035 .25"/>
    <geom type="capsule" fromto=".1 0.12 .7 .8 0.12 .7" size=".014" material="silver"/>
    <geom type="box" pos="0.1 0.12 .45" size=".035 .035 .25"/>
    <geom type="box" pos="0.8 0.12 .45" size=".035 .035 .25"/>
    <body name="crank" pos="-.5 0 .7">
      <joint name="drive" axis="0 1 0" damping=".1"/>
      <geom type="cylinder" size=".18 .025" euler="1.57079632679 0 0" mass=".4"/>
      <geom class="bolt"/>
      <geom type="capsule" fromto="0 -.035 0 .18 -.035 0" size=".018" mass=".02" material="silver"/>
      <body name="left_fitting" pos=".18 0 0">
        <joint axis="0 1 0" damping=".1"/>
        <geom class="bolt"/>
        <geom type="box" size=".025 .045 .035" mass=".03" material="silver"/>
      </body>
    </body>
    <body name="slider" pos=".58 0 .7">
      <joint name="slide" type="slide" axis="1 0 0" range="-.5 .08" damping="30"/>
      <geom type="box" size=".065 .11 .06" mass="1" material="load"/>
      <body name="right_fitting">
        <joint axis="0 1 0" damping=".1"/>
        <geom class="bolt"/>
        <geom type="box" size=".025 .045 .035" mass=".03" material="silver"/>
      </body>
    </body>
    <body name="flex_frame" pos="-.32 0 .7">
      <flexcomp name="rod" type="grid" count="37 3 3" spacing=".025 .03 .02" pos=".45 0 0" dim="3" dof="trilinear" cellcount="12 1 1" mass=".15" radius=".001" rgba=".95 .38 .12 1">
        <elasticity young="1e6" poisson=".25" damping=".01"/>
        <contact selfcollide="none" contype="0" conaffinity="0"/>
      </flexcomp>
    </body>
  </worldbody>
  <equality>
    <connect name="rod_0_0_0_attach" body1="rod_0_0_0" body2="left_fitting" anchor="0 0 0"/>
    <connect name="rod_0_0_1_attach" body1="rod_0_0_1" body2="left_fitting" anchor="0 0 0"/>
    <connect name="rod_0_1_0_attach" body1="rod_0_1_0" body2="left_fitting" anchor="0 0 0"/>
    <connect name="rod_0_1_1_attach" body1="rod_0_1_1" body2="left_fitting" anchor="0 0 0"/>
    <connect name="rod_12_0_0_attach" body1="rod_12_0_0" body2="right_fitting" anchor="0 0 0"/>
    <connect name="rod_12_0_1_attach" body1="rod_12_0_1" body2="right_fitting" anchor="0 0 0"/>
    <connect name="rod_12_1_0_attach" body1="rod_12_1_0" body2="right_fitting" anchor="0 0 0"/>
    <connect name="rod_12_1_1_attach" body1="rod_12_1_1" body2="right_fitting" anchor="0 0 0"/>
  </equality>
  <actuator>
    <!-- Torque = 50 * (2*pi/3 - angular velocity), even with zero control. -->
    <general name="crank" joint="drive" biastype="affine" gainprm="50" biasprm="104.71975512 0 -50"/>
  </actuator>
</mujoco>

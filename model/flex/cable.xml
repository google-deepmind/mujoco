<mujoco model="Cable">
  <include file="scene.xml"/>

  <option integrator="discrete"/>

  <statistic center="0 0 .3" extent="1"/>
  <visual>
    <global elevation="-30"/>
  </visual>

  <compiler autolimits="true"/>

  <size memory="2M"/>

  <worldbody>
    <flexcomp name="cable" type="grid" dim="1" count="41 1 1" spacing=".025 1 1" pos=".2 0 .6"
      radius=".005" rgba=".8 .2 .1 1" mass=".08">
      <contact condim="1" selfcollide="auto"/>
      <edge equality="true"/>
      <elasticity young="4e6" shear="1e7" damping=".005"/>
      <pin id="0 1"/>
    </flexcomp>
    <body name="slider" pos=".7 0 .6">
      <joint type="slide" axis="1 0 0" damping=".1"/>
      <geom size=".01"/>
    </body>
  </worldbody>
  <equality>
    <connect name="right_boundary" body1="cable_40" body2="slider" anchor="0 0 0"/>
  </equality>
  <contact>
    <exclude body1="cable_40" body2="slider"/>
  </contact>
  <actuator>
    <motor joint="cable_twist" ctrlrange="-.03 .03"/>
  </actuator>
</mujoco>

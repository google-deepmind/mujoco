<mujoco model="Clay">
  <compiler autolimits="true"/>

  <option timestep="0.004" solver="CG" tolerance="1e-5" integrator="discrete"/>

  <size memory="20M"/>

  <visual>
    <global elevation="-30" azimuth="135" realtime="0.5"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <map stiffness="700" shadowscale="0.5" fogstart="1" fogend="15" zfar="40" haze="1"/>
    <headlight ambient="0.12 0.12 0.12" diffuse="0.15 0.15 0.15" specular="0.05 0.05 0.05"/>
  </visual>

  <statistic meansize="0.05" center="0 0.04 0.13" extent="0.65"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"
             width="512" height="512" mark="cross" markrgb="0.8 0.8 0.8"/>
    <material name="matplane" reflectance="0.25" texture="texplane" texrepeat="10 10" texuniform="true"/>
    <material name="steel" rgba="0.42 0.46 0.52 1" specular="0.7" shininess="0.6" metallic="0.5" roughness="0.3"/>
    <material name="die" rgba="0.26 0.29 0.34 1" specular="0.8" shininess="0.7" metallic="0.6" roughness="0.25"/>
    <material name="clay_mat" rgba="0.78 0.40 0.22 1" specular="0.35" shininess="0.4"/>
  </asset>

  <worldbody>
    <!-- Overhead light for floor shadows behind the press + oblique side light to shade the '+' trench walls -->
    <light directional="true" diffuse="0.40 0.38 0.36" specular="0.12 0.12 0.12" pos="0.0 0.35 1.8" dir="0.0 0.45 -0.89"/>
    <light directional="true" diffuse="0.75 0.60 0.46" specular="0.40 0.32 0.25" pos="-1.2 0.6 0.5" dir="0.82 -0.42 -0.38" castshadow="false"/>
    <light directional="true" diffuse="0.18 0.22 0.30" specular="0.05 0.05 0.08" pos="0.8 -0.8 1.4" dir="-0.45 0.45 -0.77" castshadow="false"/>

    <geom name="ground" type="plane" size="0 0 1" material="matplane" condim="3" friction="1.5 0.005 0.0001"/>

    <!-- Hinged stamping press behind the clay block (+y) -->
    <body name="base" pos="0 0.28 0" euler="0 0 90">
      <geom name="pedestal" type="box" pos="0 0 0.052" size="0.025 0.045 0.052" material="steel" contype="0" conaffinity="0"/>
      <geom name="axle" type="cylinder" pos="0 0 0.100" euler="90 0 0" size="0.016 0.052" material="die" contype="0" conaffinity="0"/>

      <body name="arm" pos="0 0 0.082" euler="0 131 0">
        <joint name="j_stamp" type="hinge" axis="0 1 0" range="-134 0" stiffness="58" springref="-74" damping="1.4"/>
        <geom name="beam" type="capsule" fromto="0 0 0 -0.28 0 0" size="0.014" mass="0.5" material="steel" contype="0" conaffinity="0"/>

        <!-- Cross (+) stamping head centered at (0, 0) and level at bottom of stroke -->
        <body name="head" pos="-0.28 0 0">
          <geom name="weight" type="cylinder" pos="0 0 0.048" size="0.034 0.022" mass="10.5" material="steel" contype="0" conaffinity="0"/>
          <geom name="cross_x" type="box" pos="0 0 0.022" size="0.122 0.026 0.010" mass="0.3" material="steel" contype="0" conaffinity="0"/>
          <geom name="cross_y" type="box" pos="0 0 0.022" size="0.026 0.122 0.010" mass="0.3" material="steel" contype="0" conaffinity="0"/>
          <!-- Wide, deep frictionless contact blades that stamp a crisp '+' without hooking on retraction -->
          <geom name="blade_x" type="box" pos="0 0 -0.006" size="0.118 0.022 0.032" mass="0.4"
                condim="1" solref="0.003 1" solimp="0.98 0.995 0.001" priority="1" material="die"/>
          <geom name="blade_y" type="box" pos="0 0 -0.006" size="0.022 0.118 0.032" mass="0.4"
                condim="1" solref="0.003 1" solimp="0.98 0.995 0.001" priority="1" material="die"/>
        </body>
      </body>
    </body>

    <!-- Elasto-plastic clay block (17x17x5 grid) anchored at its base -->
    <flexcomp name="clay" type="grid" dim="3" count="17 17 5" spacing="0.018 0.018 0.025"
              pos="0 0 0.052" radius="0.002" mass="1.0" flatskin="false" material="clay_mat">
      <pin gridrange="0 0 0 16 16 0"/>
      <contact condim="1" solref="0.003 1" solimp="0.98 0.995 0.001" selfcollide="none"/>
      <elasticity young="4.5e4" poisson="0.0" damping="0.02" yield="0.0016"/>
    </flexcomp>
  </worldbody>

  <actuator>
    <motor name="stamp" joint="j_stamp" gear="-1" ctrlrange="-60 60"/>
  </actuator>
</mujoco>

<mujoco model="Ribbed roller">
  <compiler autolimits="true"/>
  <option timestep="0.003" solver="CG" tolerance="1e-5" integrator="discrete"/>
  <size memory="20M"/>

  <visual>
    <global elevation="-17" azimuth="139" realtime="0.3"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <map stiffness="700" fogstart="1" fogend="15" zfar="40" haze="1"/>
    <headlight ambient="0.08 0.08 0.08" diffuse="0.24 0.24 0.24" specular="0.08 0.08 0.08"/>
  </visual>

  <statistic meansize="0.025" center="0.02 -0.05 0.06" extent="0.36"/>

  <default>
    <default class="rail">
      <geom type="box" material="tray_mat" contype="0" conaffinity="0"/>
    </default>
    <default class="roller">
      <geom type="cylinder" material="roller_mat" condim="1" solref="0.003 1" priority="1"/>
      <default class="tooth">
        <geom type="box" size="0.014 0.060 0.006" mass="0.05"/>
      </default>
      <default class="hub">
        <geom material="tray_mat" contype="0" conaffinity="0"/>
      </default>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="100" height="100"/>
    <material name="grid" texture="grid" texrepeat="8 8" texuniform="true" reflectance="0.06"/>
    <material name="tray_mat" rgba="0.24 0.27 0.32 1" specular="0.5" shininess="0.5" metallic="0.5" roughness="0.35"/>
    <material name="roller_mat" rgba="0.48 0.52 0.58 1" specular="0.85" shininess="0.8" metallic="0.75" roughness="0.20"/>
    <material name="elastic_slab_mat" rgba="0.22 0.58 0.82 1" specular="0.45" shininess="0.5"/>
    <material name="plastic_slab_mat" rgba="0.86 0.48 0.22 1" specular="0.40" shininess="0.45"/>
  </asset>

  <worldbody>
    <light name="key" pos="-0.08 -0.90 1.0" dir="0.08 0.88 -0.92" cutoff="32" softness="1" diffuse=".75 .70 .62"
           ambient=".12 .12 .12" specular=".25 .24 .22"/>
    <light name="rim" type="directional" pos="0.3 0.9 0.8" dir="-0.3 -0.9 -0.6" castshadow="false"
           diffuse=".16 .20 .28" specular=".12 .14 .18"/>
    <geom name="ground" type="plane" size="0 0 1" material="grid" condim="3" friction="1.0 0.005 0.0001"/>

    <!-- Rails under the slab sides -->
    <replicate count="2" offset="0.34 0 0">
      <geom class="rail" pos="-0.236 0 0.012" size="0.022 0.135 0.012"/>
      <geom class="rail" pos="-0.104 0 0.012" size="0.022 0.135 0.012"/>
    </replicate>

    <!-- Left 3D block: elastic -->
    <flexcomp name="elastic_slab" type="grid" dim="3" dof="trilinear" count="9 13 5" cellcount="4 6 2"
              spacing="0.019 0.019 0.016" pos="-0.17 0 0.060" radius="0.004" mass="0.30"
              material="elastic_slab_mat">
      <pin gridrange="0 0 0 0 6 1  4 0 0 4 6 1"/>
      <contact condim="1" solref="0.003 1" solimp="0.96 0.99 0.001" selfcollide="none"/>
      <elasticity young="6.5e4" poisson="0.0" damping="0.015"/>
    </flexcomp>

    <!-- Right 3D block: plastic -->
    <flexcomp name="plastic_slab" type="grid" dim="3" dof="trilinear" count="13 21 5" cellcount="6 10 2"
              spacing="0.012667 0.0114 0.016" pos="0.17 0 0.060" radius="0.004" mass="0.30"
              material="plastic_slab_mat">
      <pin gridrange="0 0 0 0 10 1  6 0 0 6 10 1"/>
      <contact condim="1" solref="0.003 1" solimp="0.96 0.99 0.001" selfcollide="none"/>
      <elasticity young="6.5e4" poisson="0.0" damping="0.015" yield="0.003"/>
    </flexcomp>

    <!-- Rolling axle just above the slabs, with two four-toothed stamping wheels; the slab sides are
         pinned below the top layer so the teeth can push the edges down -->
    <body name="roller" childclass="roller" pos="0 0.22 0.114">
      <joint name="roll_y" type="slide" axis="0 -1 0" range="-0.05 0.56" stiffness="420" springref="0.54" damping="150"/>
      <joint name="roll_spin" type="hinge" axis="1 0 0" damping="0.1"/>
      <geom fromto="-0.25 0 0 0.25 0 0" size="0.010" mass="0.6"/>
      <replicate count="2" offset="0.34 0 0">
        <geom class="hub" pos="-0.17 0 0" euler="0 90 0" size="0.018 0.018" mass="0.05"/>
        <geom class="tooth" pos="-0.17 0 0"/>
        <geom class="tooth" pos="-0.17 0 0" euler="90 0 0"/>
      </replicate>
    </body>
  </worldbody>

  <equality>
    <joint joint1="roll_spin" joint2="roll_y" polycoef="0 16.7 0 0 0" solref="0.002 1"/>
  </equality>
</mujoco>

<mujoco model="Hyperbolic arch">
  <visual>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <!-- Frictional stability requires elliptic cones and large impratio. The
       discrete integrator treats the contact rows implicitly, so the
       authored contact stiffness is honored at an 8 ms timestep and the
       settled arch rests with no measurable creep; noslip would topple it at
       this timestep. -->
  <option timestep="8e-3" integrator="discrete" cone="elliptic" impratio="100"/>

  <!-- Catenary-family arch after the Rigid-IPC / FBF design: 29 voussoirs
       with joints normal to the centerline (a funicular arch carries pure
       compression, no joint shear) and cross-sections tapering 2:1 from
       springing to crown, where the axial force is lowest. The centerline is
       the weighted catenary: the funicular of the tapered self-weight, so the
       thrust line stays at mid-section. One flank is authored; replicate
       mirrors it about the vertical axis; the voussoir positions are the arch
       as settled under load, within 0.1 mm of the funicular, so it loads at
       rest. Bed faces carry a 0.4 mm
       small-on-large inset, invisible but enough to keep the contact
       manifold determinate: as quiet as a coarser inset, and 50x quieter than
       perfectly-fitting voussoirs, whose degenerate edge-edge joints ring. -->

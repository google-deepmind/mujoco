load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

cc_library(
    name = "mjdb_provider",
    srcs = ["mjdb_provider.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-ffp-contract=off",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//:visibility"],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
        "//src/user:user_util",
    ],
    alwayslink = 1,
)

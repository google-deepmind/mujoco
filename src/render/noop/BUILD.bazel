load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "noop",
    srcs = ["render_noop.c"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = ["//:libmujoco_hdrs"],
)

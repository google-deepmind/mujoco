load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package(default_visibility = ["//:__subpackages__"])

# Public mjr_* headers live in //:libmujoco_hdrs.
# buildifier: disable=no-hdrs-no-alwayslink
cc_library(
    name = "noop",
    srcs = ["render_noop.c"],
    conlyopts = [
        "-std=c11",
        "-Werror",
        "-Wall",
        "-Wpedantic",
        "-Wstrict-prototypes",
        "-Wshadow",
        "-Wunused",
        "-Wvla",
        "-Wimplicit-fallthrough",
    ],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = ["//:libmujoco_hdrs"],
)

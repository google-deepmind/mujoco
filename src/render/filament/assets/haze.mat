material {
    name : haze,
    shadingModel : unlit,
    blending : fade,
    depthWrite : false,
    culling : front,
    flipUV : false,
    variantFilter : [ skinning, shadowReceiver, vsm, fog ],
    parameters : [
        { type : float4, name : HazeColor },
        { type : float, name : HazeRatio }
    ],
    requires : [
        uv0
    ]
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
    // reshape the unit cylinder (bands 0, 0.5, 1) into an inverted cone: the
    // bottom ring shrinks to the ground disk rim (radius 1 - r, height 0), the
    // top ring stays at radius 1 and camera eye height (height 1), and the
    // opaque middle ring is lifted onto the cone at height r / (1 + r)
    float r = materialParams.HazeRatio;
    float band = material.uv0.y;
    float h = 0.0;
    if (band > 0.75) {
      h = 1.0;
    } else if (band > 0.25) {
      h = r / (1.0 + r);
    }
    float scale = 1.0 - r * (1.0 - h);
    mat4 transform = getWorldFromModelMatrix();
    vec3 local_pos = vec3(getPosition().xy * scale, h);
    material.worldPosition = mulMat4x4Float3(transform, local_pos);
  }
}

fragment {
  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    float alpha = materialParams.HazeColor.a * getUV0().x;
    vec3 color = materialParams.HazeColor.rgb;
#if MATERIAL_FEATURE_LEVEL > 0
    // match the skybox, which filament scales by the IBL intensity
    color *= frameUniforms.iblLuminance;
#endif
    material.baseColor = vec4(color * alpha, alpha);
  }
}

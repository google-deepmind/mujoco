load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "ui_main",
    srcs = ["ui_main.c"],
    hdrs = ["ui_main.h"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine:engine_array_safety",
        "//src/render/classic:glad",
    ],
)

# A resource provider plugin which serves ROS-style package:// URIs.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

cc_library(
    name = "package_uri",
    srcs = ["package_uri.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//:visibility"],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
    alwayslink = 1,
)

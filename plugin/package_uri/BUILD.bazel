# Description:
#   Resource provider for ROS-style package:// URIs.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

package(default_visibility = ["//:visibility"])

licenses(["notice"])

cc_library(
    name = "package_uri",
    srcs = ["package_uri.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
    alwayslink = 1,
)

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package_group(
    name = "_impl_visibility",
    packages =
        [
            "//google/webmj/...",
            "//sample/...",
            "//simulate/...",
            "//test/...",
            "//third_party/py/dm_control/mujoco/...",
            "//third_party/py/mujoco/...",
        ],
)

cc_library(
    name = "sdf",
    srcs = [
        "sdf.cc",
    ],
    hdrs = [
        "sdf.h",
    ],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
    alwayslink = 1,
)


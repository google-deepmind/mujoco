# An actuator plugin which implements a configurable PID controller.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

cc_library(
    name = "pid",
    srcs = ["pid.cc"],
    hdrs = ["pid.h"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
)

cc_library(
    name = "register",
    srcs = [
        "register.cc",
    ],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//:visibility"],
    deps = [
        ":pid",
        "//:libmujoco_hdrs",
    ],
    alwayslink = 1,
)

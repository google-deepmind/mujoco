load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package_group(
    name = "_impl_visibility",
    packages =
        [
            "//python/mujoco/...",
            "//sample/...",
            "//simulate/...",
            "//test/...",
        ],
)

cc_library(
    name = "elasticity",
    srcs = [
        "elasticity.cc",
    ],
    hdrs = [
        "elasticity.h",
    ],
    conlyopts = ["-std=c11"],
    copts = ["-I" + MJ_ROOT + "/src"],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
    alwayslink = 1,
)

cc_library(
    name = "cable",
    srcs = [
        "cable.cc",
    ],
    hdrs = [
        "cable.h",
    ],
    conlyopts = ["-std=c11"],
    copts = ["-I" + MJ_ROOT + "/src"],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":elasticity",
        "//:libmujoco_hdrs",
    ],
    alwayslink = 1,
)

cc_library(
    name = "register",
    srcs = [
        "register.cc",
    ],
    conlyopts = ["-std=c11"],
    copts = ["-I" + MJ_ROOT + "/src"],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//:visibility"],
    deps = [
        ":cable",
        "//:libmujoco_hdrs",
    ],
    alwayslink = 1,
)

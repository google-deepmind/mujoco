load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

package_group(
    name = "_impl_visibility",
    packages =
        [
            "//sample/...",
            "//simulate/...",
            "//test/...",
            "//third_party/py/mujoco/...",
        ],
)

cc_library(
    name = "touch_grid",
    srcs = [
        "touch_grid.cc",
    ],
    hdrs = [
        "touch_grid.h",
    ],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
    alwayslink = 1,
)

cc_library(
    name = "register",
    srcs = [
        "register.cc",
    ],
    hdrs = [
        "touch_grid.h",
    ],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//:visibility"],
    deps = [
        ":touch_grid",
        "//:libmujoco_hdrs",
    ],
    alwayslink = 1,
)

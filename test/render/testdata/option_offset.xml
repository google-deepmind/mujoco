<mujoco model="option_offset">
  <!-- A bar along x under a spotlight, away from the origin, with a green tip
       at its far end. The golden test renders it with an mjvOption offset
       that brings the bar, with its light, to the origin. -->
  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.20 0.20 0.22" rgb2="0.28 0.28 0.30"/>
    <material name="floor" texture="floor_tex" texrepeat="4 4" texuniform="true" roughness="0.8"/>
  </asset>

  <worldbody>
    <camera name="default" pos="0 -3 3" xyaxes="1 0 0  0 0.707 0.707"/>

    <light pos="0 0 6" dir="0 0 -1" directional="true" diffuse="1 1 1" intensity="6000"/>
    <light type="spot" pos="0.8 0 2" dir="0 0 -1" diffuse="1.0 0.85 0.55" intensity="100000" range="6"
           cutoff="20"/>

    <geom name="ground" type="plane" size="4 4 0.05" material="floor"/>
    <geom name="bar" type="box" pos="0.8 0 0.1" size="0.5 0.1 0.1" rgba="0.8 0.1 0.1 1"/>
    <geom name="tip" type="sphere" pos="1.3 0 0.3" size="0.1" rgba="0.1 0.7 0.1 1"/>
  </worldbody>
</mujoco>

        "//test/engine/testdata/sleep:test_mjcf",
        "//test/testdata:model",
        "//test/user/testdata:test_mjcf",
    ],
    shard_count = 4,
    deps = [
        "//:mujoco",
        "//test:fixture",
        "@googletest//:gtest_main",
    ],

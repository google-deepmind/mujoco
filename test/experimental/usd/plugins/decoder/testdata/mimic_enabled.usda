#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
    )
    {
        def Cube "Geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.1
        }

        def Xform "Link1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            def Cube "Geometry" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 0.1
            }

            def PhysicsRevoluteJoint "Leader"
            {
                rel physics:body0 = </World/Base>
                rel physics:body1 = </World/Base/Link1>
            }

            def Xform "Link2" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                def Cube "Geometry" (
                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                )
                {
                    double size = 0.1
                }

                def PhysicsRevoluteJoint "Follower" (
                    prepend apiSchemas = ["NewtonMimicAPI"]
                )
                {
                    bool physics:jointEnabled = true
                    bool newton:mimicEnabled = false
                    rel newton:mimicJoint = </World/Base/Link1/Leader>
                    rel physics:body0 = </World/Base/Link1>
                    rel physics:body1 = </World/Base/Link1/Link2>
                }
            }
        }

        def PhysicsFixedJoint "Fixed"
        {
            rel physics:body0 = None
            rel physics:body1 = </World/Base>
        }
    }
}

<mujoco>
  <!--
  Same as force_torque_lever.xml, but with both bodies and the sensor site rotated and a
  torquescale of 4, so the rotational constraint force is neither world-aligned nor unit-scaled.
  The sensors should register the weight of both bodies and the moment of body2's weight about
  the sensor, both in the site frame. The tilted lever makes the moment sensitive to the sag of
  the weld, which the high impedance keeps negligible.
  -->
  <option gravity="0 0 -1"/>

  <worldbody>
    <body name="body1" euler="0 45 0">
      <geom type="box" size="0.05 0.05 0.05"/>
      <site name="sensor" euler="0 0 90"/>
    </body>
    <body name="body2" pos="0 1 0" euler="30 30 30">
      <joint type="free"/>
      <inertial pos="1 0 0" mass="1" diaginertia="1 1 1"/>
      <geom type="box" size="0.05 0.05 0.05" pos="1 0 0"/>
    </body>
  </worldbody>

  <equality>
    <weld body1="body1" body2="body2" torquescale="4" solimp="0.999 0.999 0.001"/>
  </equality>

  <sensor>
    <force site="sensor" user="0 1.41421356237 1.41421356237"/>
    <torque site="sensor" user="-0.75 -1.166386108 1.166386108"/>
  </sensor>
</mujoco>

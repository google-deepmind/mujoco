<mujoco>
  <!--
  A body on a vertical slider hangs from a fixed tendon spring. A fixed tendon acts through the
  joint, so the sensor on the body registers the force holding it: 1.
  -->
  <option gravity="0 0 -1"/>

  <worldbody>
    <body name="fixed">
      <body name="slider">
        <joint name="slide" type="slide" axis="0 0 1"/>
        <geom type="box" size="0.05 0.05 0.05" mass="1"/>
        <site name="sensor"/>
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="spring" stiffness="100" damping="20">
      <joint joint="slide" coef="1"/>
    </fixed>
  </tendon>

  <sensor>
    <force site="sensor" user="0 0 1"/>
  </sensor>
</mujoco>

<mujoco>
  <!--
  Same as spring_free.xml, but the length of the tendon is fixed by an equality constraint.
  -->
  <option gravity="0 0 -1"/>

  <worldbody>
    <body name="fixed">
      <body name="fixedend">
        <site name="fixedend"/>
      </body>
    </body>
    <body name="mass" pos="0 0 -0.5">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.05" mass="1"/>
      <site name="mass"/>
      <body name="massend">
        <site name="massend"/>
      </body>
    </body>
  </worldbody>

  <tendon>
    <spatial name="rope">
      <site site="fixedend"/>
      <site site="massend"/>
    </spatial>
  </tendon>

  <equality>
    <tendon tendon1="rope"/>
  </equality>

  <sensor>
    <force site="fixedend" user="0 0 1"/>
    <force site="massend" user="0 0 -1"/>
    <force site="mass" user="0 0 0"/>
  </sensor>
</mujoco>

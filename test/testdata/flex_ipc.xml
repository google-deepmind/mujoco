<mujoco model="flex_ipc">
  <option timestep="0.005" integrator="discrete" solver="CG">
    <flag ipc="enable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="32"/>
    <texture name="grid" type="2d" builtin="checker" width="32" height="32" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="4096"/>
    <global offwidth="800" offheight="800"/>
  </visual>

  <worldbody>
    <light pos="0 0 1" dir="0 0 -1"/>
    <geom name="floor" type="plane" size=".5 .5 .05" material="grid"/>
    <geom name="obstacle" type="capsule" size=".015 .015" pos="0 0 .015" euler="0 90 0" rgba=".7 .3 .3 1"/>

    <flexcomp name="cloth1" type="grid" dim="2" count="3 3 1" spacing=".025 .025 .025"
              pos="0 0 .033" radius=".001" mass=".1" rgba="1 .8 .1 1">
      <pin id="4"/>
      <elasticity young="1e5" poisson="0.2" damping="0.001" thickness="0.002" elastic2d="both"/>
    </flexcomp>

    <flexcomp name="cloth2" type="grid" dim="2" count="3 3 1" spacing=".022 .022 .022"
              pos="0 0 .037" euler="0 0 45" radius=".0015" mass=".08" rgba=".2 .7 .9 1">
      <edge equality="true"/>
    </flexcomp>
  </worldbody>
</mujoco>

        "//:mujoco",
        "//plugin/actuator:register",
        "//test:fixture",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@googletest//:gtest_main",
    ],

# Description:
#   Tests for mujoco/src/engine

load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

cc_test(
    name = "xml_api_test",
    srcs = ["xml_api_test.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT,
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    deps = [
        "//:mujoco",
        "//src/xml:xml_api",
        "//test:fixture",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "xml_native_reader_test",
    srcs = ["xml_native_reader_test.cc"],
    # LargeTextureTest 2.1 GB heap allocation fails with OOM on TAP Windows VM.
    args = select({
        "@platforms//os:windows": [
            "--gunit_filter=-*LargeTexture*",
        ],
        "//conditions:default": [],
    }),
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT,
        "-I" + MJ_ROOT + "/include",
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    data = ["//test/xml/testdata:test_mjcf"],
    shard_count = 2,
    deps = [
        "//:mujoco",
        "//src/cc:array_safety",
        "//src/user:user_model",
        "//src/xml:xml_api",
        "//test:compare_model",
        "//test:fixture",
        "@googletest//:gtest_main",
    ],
)


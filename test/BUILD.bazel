_NM = "$(NM)"

# Checks that the shared MuJoCo library exports exactly MuJoCo's API.
genrule(
    name = "mujoco_shared_exports",
    srcs = ["//:mujoco_shared"],
    outs = ["mujoco_shared_exports.txt"],
    # Lists the symbols the shared library exports, without the extra leading
    # underscore of Mach-O names or ELF symbol versions. Running nm here, at
    # build time, lets the test itself run on any host.
    cmd = select({
        "@platforms//os:macos": _NM + " -g --defined-only $< | awk '{print $$NF}' | sed 's/^_//' > $@",
        "//conditions:default": _NM + " -D --defined-only $< | awk '{print $$NF}' | sed 's/@.*$$//' > $@",
    }),
    toolchains = ["@rules_cc//cc:current_cc_toolchain"],
)

sh_test(
    name = "mujoco_shared_exports_test",
    size = "small",
    srcs = ["mujoco_shared_exports_test.sh"],
    args = [
        "$(rootpath :mujoco_shared_exports)",
        "$(rootpath //python/mujoco/introspect:functions.py)",
        "$(rootpaths //:mujoco_api_headers)",
    ],
    data = [
        ":mujoco_shared_exports",
        "//:mujoco_api_headers",
        "//python/mujoco/introspect:functions.py",
    ],
)

# A plugin built with the mujoco_plugin macro, and a test that loads it into
# the shared engine library.
cc_library(
    name = "mujoco_plugin_test_plugin_lib",
    testonly = True,
    srcs = ["mujoco_plugin_test_plugin.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT,
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    deps = ["//:mujoco"],
    alwayslink = True,
)

mujoco_plugin(
    name = "mujoco_plugin_test_plugin",
    testonly = True,
    deps = [":mujoco_plugin_test_plugin_lib"],
)

cc_test(
    name = "mujoco_plugin_test",
    srcs = ["mujoco_plugin_test.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT,
        "-I" + MJ_ROOT + "/src",
    ],
    cxxopts = ["-std=c++20"],
    data = [":mujoco_plugin_test_plugin"],
    dynamic_deps = ["//:mujoco_shared"],
    env = {"MUJOCO_PLUGIN_TEST_LIBRARY": "$(rootpath :mujoco_plugin_test_plugin)"},
    tags = mujoco_test_tags,
    deps = ["//:mujoco"],
)

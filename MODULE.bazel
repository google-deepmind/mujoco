module(
    name = "mujoco",
    version = "3.14.1",
    bazel_compatibility = [
        ">=9.2.0",
        "<10.0.0",
    ],
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "glfw", version = "3.4.0.bcr.3")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "lodepng", version = "0.0.0-20250506-17d08dd")
bazel_dep(name = "marchingcubecpp", version = "0.0.0-20230911-f03a1b3")
bazel_dep(name = "miniz", version = "3.1.1")

bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "openusd", version = "25.11.bcr.3")
bazel_dep(name = "onetbb", version = "2022.2.0")
bazel_dep(name = "libx11", version = "1.8.12.bcr.5")
bazel_dep(name = "libxcb", version = "1.17.0.bcr.2")
bazel_dep(name = "libxext", version = "1.3.6")
bazel_dep(name = "opengl-registry", version = "0.0.0-20250707")
bazel_dep(name = "egl-registry", version = "0.0.0-20250527")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "emsdk", version = "6.0.10")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

bazel_dep(name = "toolchains_llvm", version = "1.9.1", dev_dependency = True)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "20.1.8",
)
use_repo(llvm, "llvm_toolchain")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "20.18.0")
use_repo(node, "nodejs")

emscripten = use_extension("@emsdk//:emscripten_deps.bzl", "emscripten_deps")
emscripten.config(version = "4.0.10")

bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")
use_repo(python, "python_3_11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mujoco_pip",
    python_version = "3.11",
    requirements_lock = "//bazel/python:requirements_lock.txt",
)
pip.parse(
    hub_name = "mjx_pip",
    python_version = "3.11",
    requirements_lock = "//bazel/python:mjx_requirements_lock.txt",
)
pip.parse(
    hub_name = "mjx_cuda_pip",
    python_version = "3.11",
    requirements_lock = "//bazel/python:mjx_cuda_requirements_lock.txt",
)
pip.parse(
    hub_name = "mujoco_usd_pip",
    python_version = "3.11",
    requirements_lock = "//python:build_requirements_usd.txt",
)
pip.parse(
    hub_name = "mujoco_sysid_pip",
    python_version = "3.11",
    requirements_lock = "//bazel/python:sysid_requirements_lock.txt",
)
use_repo(pip, "mjx_cuda_pip", "mjx_pip", "mujoco_pip", "mujoco_sysid_pip", "mujoco_usd_pip")

deps = use_extension("//bazel:repositories.bzl", "mujoco_dependencies")
use_repo(deps, "mujoco_deps_ccd", "mujoco_deps_qhull", "mujoco_deps_tinyobjloader", "mujoco_deps_tinyxml2", "pybind11")
use_repo(deps, "eigen", "google_benchmark")

optional = use_extension("//bazel/optional:repositories.bzl", "mujoco_optional_dependencies")
use_repo(optional, "mujoco_emscripten", "mujoco_filament", "mujoco_font_awesome", "mujoco_font_mono", "mujoco_font_next", "mujoco_imgui", "mujoco_implot", "mujoco_libwebp", "mujoco_newton_schemas", "mujoco_sdl2", "mujoco_wasm_npm")

register_toolchains("//bazel/optional:emscripten_linux")

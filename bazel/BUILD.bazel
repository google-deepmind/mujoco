load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "mujoco.exports",
    "mujoco.map",
    "repositories.bzl",
])

cc_binary(
    name = "parity",
    srcs = ["parity.cc"],
    deps = ["//:mujoco_shared"],
)

bool_flag(
    name = "avx",
    build_setting_default = True,
)

bool_flag(
    name = "avx_intrinsics",
    build_setting_default = True,
)

bool_flag(
    name = "harden",
    build_setting_default = False,
)

bool_flag(
    name = "lto",
    build_setting_default = True,
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "wasm",
    constraint_values = ["@platforms//os:emscripten"],
)

config_setting(
    name = "avx_posix",
    constraint_values = ["@platforms//cpu:x86_64"],
    flag_values = {":avx": "true"},
)

config_setting(
    name = "avx_windows",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    flag_values = {":avx": "true"},
)

config_setting(
    name = "intrinsics",
    constraint_values = ["@platforms//cpu:x86_64"],
    flag_values = {
        ":avx": "true",
        ":avx_intrinsics": "true",
    },
)

config_setting(
    name = "harden_enabled",
    flag_values = {":harden": "true"},
)

config_setting(
    name = "harden_windows",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {":harden": "true"},
)

config_setting(
    name = "harden_linux",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {":harden": "true"},
)

config_setting(
    name = "harden_macos",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {":harden": "true"},
)

config_setting(
    name = "lto_enabled",
    flag_values = {":lto": "true"},
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "lto_windows",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {":lto": "true"},
    values = {"compilation_mode": "opt"},
)

bool_flag(
    name = "filament_mjr_compat",
    build_setting_default = False,
)

config_setting(
    name = "compat_enabled",
    flag_values = {":filament_mjr_compat": "true"},
)

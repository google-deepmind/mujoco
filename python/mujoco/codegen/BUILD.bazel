# Description:
#   Code generation utilities for MuJoCo Python bindings.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//python/mujoco:__pkg__"])

licenses(["notice"])

py_library(
    name = "code_builder",
    srcs = ["code_builder.py"],
    imports = [".."],
    visibility = ["//:visibility"],
)

py_binary(
    name = "generate_enum_traits",
    srcs = ["generate_enum_traits.py"],
    deps = [
        "//python/mujoco/introspect:ast_nodes",
        "//python/mujoco/introspect:enums",
        "//python/mujoco/pypi:absl_app",
    ],
)

py_binary(
    name = "generate_function_traits",
    srcs = ["generate_function_traits.py"],
    deps = [
        "//python/mujoco/introspect:ast_nodes",
        "//python/mujoco/introspect:functions",
        "//python/mujoco/pypi:absl_app",
    ],
)

py_binary(
    name = "generate_spec_bindings",
    srcs = ["generate_spec_bindings.py"],
    deps = [
        "//python/mujoco/introspect:ast_nodes",
        "//python/mujoco/introspect:enums",
        "//python/mujoco/introspect:structs",
        "//python/mujoco/pypi:absl_app",
    ],
)

py_library(
    name = "generate_cs_bindings",
    srcs = ["generate_cs_bindings.py"],
    imports = [".."],
    deps = [
        "//python/mujoco/introspect:ast_nodes",
        "//python/mujoco/introspect:enums",
        "//python/mujoco/introspect:functions",
        "//python/mujoco/introspect:structs",
        "//python/mujoco/pypi:absl_app",
        "//python/mujoco/pypi:absl_flags",
    ],
)

py_test(
    name = "generate_cs_bindings_test",
    srcs = ["generate_cs_bindings_test.py"],
    main_module = "codegen.generate_cs_bindings_test",
    deps = [
        ":generate_cs_bindings",
        "//python/mujoco/pypi:absltest",
        "//python/mujoco/pypi:parameterized",
    ],
)

    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [
        ":errors_header",
        ":function_traits",
        ":raw",
        ":structs_header",
        ":structs_wrappers",  # buildcleaner: keep
        ":vfs",
        "//:libmujoco_hdrs",
        "//:mujoco",  # buildcleaner: keep

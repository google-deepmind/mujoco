# Description:
#   Python bindings for the MuJoCo physics engine.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@pybind11_bazel//:build_defs.bzl", "pybind_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//python/mujoco:build_defs.bzl", "mujoco_pybind_extension")

package_group(
    name = "visibility",
    includes = [
        "//:visibility",
    ],
)

licenses(["notice"])

exports_files([
    "LICENSE",
    "setup.py",
    "build_requirements.txt",
    "CMakeLists.txt",
])

# A single shared copy of the MuJoCo engine (plus the bundled plugins) for the
# extension modules below. Each extension module is its own shared object, so
# linking the engine statically into each one would give every module its own
# copy of the engine's global state (plugin registry, error handlers,
# allocators); the CMake build avoids this the same way, with a shared
# libmujoco. In the Bazel build, mujoco_pybind_extension links this into every
# extension.
cc_shared_library(
    name = "libmujoco",
    # The engine and plugin targets, which are the only libraries linked in.
    exports_filter = ["//:__subpackages__"],
    shared_lib_name = select({
        "@platforms//os:macos": "libmujoco_python.dylib",
        "//conditions:default": "libmujoco_python.so",
    }),
    deps = [
        "//:mujoco",
        "//plugin/actuator:register",
        "//plugin/elasticity:register",
        "//plugin/sdf:register",
        "//plugin/sensor:register",
    ],
)

py_library(
    name = "mujoco",
    srcs = [
        "__init__.py",
        "gl_context.py",
        "minimize.py",
        "renderer.py",
        "rollout.py",
    ],
    data = [
        ":_callbacks",
        ":_constants",
        ":_enums",
        ":_errors",
        ":_functions",
        ":_render",
        ":_rollout",
        ":_specs",
        ":_structs",
    ],
    imports = [".."],
    visibility = [":visibility"],
    deps = [
        "//python/mujoco/pypi:absl_py",
        "//python/mujoco/pypi:epath",
        "//python/mujoco/pypi:glfw",
        "//python/mujoco/pypi:numpy",  # buildcleaner: keep
        "//python/mujoco/pypi:pyopengl",
        "//python/mujoco/pypi:typing_extensions",
        "//python/mujoco/pypi:websockets",
    ],
)

genrule(
    name = "_genrule_enum_traits.h",
    outs = ["enum_traits.h"],
    cmd = "$(location //python/mujoco/codegen:generate_enum_traits) > $@",
    tools = ["//python/mujoco/codegen:generate_enum_traits"],
)

config_setting(
    name = "_cpu_aarch64_config",
    constraint_values = ["@platforms//cpu:aarch64"],
)

config_setting(
    name = "_cpu_arm_config",
    constraint_values = ["@platforms//cpu:arm"],
)

selects.config_setting_group(
    name = "_arm_build",
    match_any = [
        ":_cpu_aarch64_config",
        ":_cpu_arm_config",
    ],
)

cc_library(
    name = "gil_header",
    hdrs = ["gil.h"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
)

cc_library(
    name = "mujoco_private_api_header",
    hdrs = ["private.h"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = ["//:libmujoco_hdrs"],
)

mujoco_pybind_extension(
    name = "_callbacks",
    srcs = ["callbacks.cc"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [
        ":errors_header",
        ":gil_header",
        ":raw",
        ":structs_header",
        "//:mujoco",  # buildcleaner: keep
    ],
)

mujoco_pybind_extension(
    name = "_constants",
    srcs = ["constants.cc"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [
        "//:libmujoco_hdrs",
        "//:mujoco",  # buildcleaner: keep
    ],
)

cc_library(
    name = "enum_traits",
    hdrs = ["enum_traits.h"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    # Generated, so in the Bazel export it is under bazel-bin, not next to the
    # sources that include it.
    includes = ["."],
    deps = ["//:libmujoco_hdrs"],
)

mujoco_pybind_extension(
    name = "_enums",
    srcs = ["enums.cc"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [

genrule(
    name = "_genrule_specs.cc.inc",
    outs = ["specs.cc.inc"],
    cmd = "$(location //python/mujoco/codegen:generate_spec_bindings) > $@",
    tools = ["//python/mujoco/codegen:generate_spec_bindings"],
)

# The generated specs.cc.inc, as a header library. Bazel puts generated files
# under bazel-bin, outside specs.cc's source directory, so in the Bazel export
# specs.cc's `#include "specs.cc.inc"` needs the `includes` path.
cc_library(
    name = "specs_inc",
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    includes = ["."],
    textual_hdrs = ["specs.cc.inc"],
)

mujoco_pybind_extension(
    name = "_specs",
    srcs = ["specs.cc"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [
        ":errors_header",
        ":raw",
        ":specs_inc",
        ":specs_wrapper",
        ":structs_header",
        ":vfs",
        "//:mujoco",  # buildcleaner: keep
        "@eigen",
    ],
)


pybind_library(
    name = "specs_wrapper",
    srcs = [
        "specs_wrapper.cc",
    ],
    hdrs = [
        "specs_wrapper.h",
    ],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    visibility = [":visibility"],
    deps = [
        ":errors_header",
        ":mujoco_private_api_header",
        ":raw",
        ":structs_header",
        "//:libmujoco_hdrs",
    ],

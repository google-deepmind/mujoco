mujoco_pybind_extension(
    name = "_errors",
    srcs = ["errors.cc"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [":errors_header"],
)

pybind_library(
    name = "functions_header",
    hdrs = ["functions.h"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [
        ":errors_header",
        ":structs_header",
        "//:libmujoco_hdrs",
        "//python/mujoco/util:array_traits",
        "//python/mujoco/util:crossplatform",
        "//python/mujoco/util:func_wrap",
        "//python/mujoco/util:tuple_tools",
        "//src/engine:engine_util_errmem",
        "@eigen",
    ],
)

mujoco_pybind_extension(
    name = "_functions",
    srcs = ["functions.cc"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    deps = [
        ":errors_header",
        ":function_traits",
        ":functions_header",
        ":mujoco_private_api_header",
        ":raw",
        ":structs_header",
        "//:mujoco",  # buildcleaner: keep

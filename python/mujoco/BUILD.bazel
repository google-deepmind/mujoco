)

cc_library(
    name = "raw",
    hdrs = ["raw.h"],
    conlyopts = ["-std=c11"],
    cxxopts = ["-std=c++20"],
    visibility = ["//visibility:private"],
    deps = ["//:libmujoco_hdrs"],

# PyPI dependencies of the Bazel build of the MuJoCo Python bindings.
#
# This file is only used by the open-source Bazel build.
#
# The exported Python BUILD files reference these aliases rather than the pip
# hub directly, so that several internal labels that map onto the same PyPI
# package (e.g. absltest and parameterized -> absl-py) never collapse into
# duplicate entries in a single deps list.
#
# The @mujoco_pip hub is built from python/build_requirements.txt, the same
# hashed lock file that .github/workflows/build_steps.sh installs for the CMake
# build, so both builds test the same package versions. A package aliased here
# must be listed in that file.

package(default_visibility = ["//visibility:public"])

alias(
    name = "absl_app",
    actual = "@mujoco_pip//absl_py",
)

alias(
    name = "absl_flags",
    actual = "@mujoco_pip//absl_py",
)

alias(
    name = "absltest",
    actual = "@mujoco_pip//absl_py",
)

alias(
    name = "parameterized",
    actual = "@mujoco_pip//absl_py",
)

alias(
    name = "epath",
    actual = "@mujoco_pip//etils",
)

alias(
    name = "glfw",
    actual = "@mujoco_pip//glfw",
)

alias(
    name = "numpy",
    actual = "@mujoco_pip//numpy",
)

alias(
    name = "pyopengl",
    actual = "@mujoco_pip//pyopengl",
)

alias(
    name = "websockets",
    actual = "@mujoco_pip//websockets",
)
